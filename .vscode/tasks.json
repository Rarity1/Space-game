{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "Configure Debug",
			"command": "${env:SHELL}",
			"args": [
				"cmake",
				"--preset",
				"debug"
			],
			"problemMatcher": [],
			"detail": "CMake configure task"
		},
		{
			"type": "shell",
			"label": "Build Debug",
			"command": "${env:SHELL}",
			"args": [
				"cmake",
				"--build",
				"./out/build/Debug"
			],
			"group": "build",
			"problemMatcher": [],
			"detail": "CMake build task",
			"dependsOn": [
			]
		}
	]
}